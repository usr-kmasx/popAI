diff --git a/src/model/upscaler/esrgan_layout.hpp b/src/model/upscaler/esrgan_layout.hpp
new file mode 100644
--- /dev/null
+++ b/src/model/upscaler/esrgan_layout.hpp
@@ -0,0 +1,37 @@
+#ifndef SD_ESRGAN_LAYOUT_HPP
+#define SD_ESRGAN_LAYOUT_HPP
+
+#include <cstdint>
+#include <stdexcept>
+#include <vector>
+
+inline std::vector<float> esrgan_pixel_unshuffle(const float* input, int64_t width,
+                                               int64_t height, int64_t channels,
+                                               int64_t batches, int64_t factor) {
+    if (!input || factor < 1 || width < 1 || height < 1 || channels < 1 || batches < 1 ||
+        width % factor != 0 || height % factor != 0) {
+        throw std::invalid_argument("ESRGAN input is not divisible by pixel-unshuffle factor");
+    }
+    const int64_t out_width = width / factor;
+    const int64_t out_height = height / factor;
+    const int64_t out_channels = channels * factor * factor;
+    std::vector<float> output(width * height * channels * batches);
+    for (int64_t n = 0; n < batches; ++n) {
+        for (int64_t c = 0; c < channels; ++c) {
+            for (int64_t dy = 0; dy < factor; ++dy) {
+                for (int64_t dx = 0; dx < factor; ++dx) {
+                    const int64_t out_c = c * factor * factor + dy * factor + dx;
+                    for (int64_t y = 0; y < out_height; ++y) {
+                        for (int64_t x = 0; x < out_width; ++x) {
+                            output[x + out_width * (y + out_height * (out_c + out_channels * n))] =
+                                input[x * factor + dx + width * (y * factor + dy + height * (c + channels * n))];
+                        }
+                    }
+                }
+            }
+        }
+    }
+    return output;
+}
+
+#endif
