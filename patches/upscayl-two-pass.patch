+// The PNG round trip between passes previously carried these same 8-bit pixels.
+static bool apply_second_pass(const RealESRGAN &model, ncnn::Mat &image)
+{
+    const int scale = model.scale;
+    if (scale <= 0 || image.w > INT_MAX / scale || image.h > INT_MAX / scale)
+        return false;
+
+    const int w = image.w * scale;
+    const int h = image.h * scale;
+    if (static_cast<size_t>(w) > INT_MAX / image.elemsize / h)
+        return false;
+
+    ncnn::Mat enlarged(w, h, image.elemsize, image.elempack);
+    if (enlarged.empty())
+        return false;
+
+    const auto now = std::chrono::system_clock::now().time_since_epoch();
+    const auto started_ms = std::chrono::duration_cast<std::chrono::milliseconds>(now).count();
+    fprintf(stderr, "[popAI] upscale pass 2 %lld\n", static_cast<long long>(started_ms));
+    if (model.process(image, enlarged) != 0)
+        return false;
+    image = enlarged;
+    return true;
+}
