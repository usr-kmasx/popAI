--- /dev/null
+++ b/src/final-png.h
@@ -0,0 +1,46 @@
+#pragma once
+
+#include <cstdio>
+#include <png.h>
+
+// Encode rows directly from the post-resize buffer. Keep its original stride
+// and use the same floor division as the center crop in the Python fallback.
+static bool write_final_png(const char* path, const unsigned char* pixels,
+                            int width, int height, int channels, int out_w, int out_h)
+{
+    if (!pixels || out_w <= 0 || out_h <= 0 || out_w > width || out_h > height ||
+        channels < 1 || channels > 4)
+        return false;
+
+    FILE* file = std::fopen(path, "wb");
+    if (!file) return false;
+    png_structp writer = png_create_write_struct(PNG_LIBPNG_VER_STRING, nullptr, nullptr, nullptr);
+    png_infop info = writer ? png_create_info_struct(writer) : nullptr;
+    if (!info)
+    {
+        if (writer) png_destroy_write_struct(&writer, nullptr);
+        std::fclose(file);
+        return false;
+    }
+    bool written = false;
+    if (setjmp(png_jmpbuf(writer)) == 0)
+    {
+        const int color[] = {PNG_COLOR_TYPE_GRAY, PNG_COLOR_TYPE_GRAY_ALPHA,
+                             PNG_COLOR_TYPE_RGB, PNG_COLOR_TYPE_RGBA};
+        png_init_io(writer, file);
+        png_set_IHDR(writer, info, out_w, out_h, 8, color[channels - 1],
+                     PNG_INTERLACE_NONE, PNG_COMPRESSION_TYPE_DEFAULT, PNG_FILTER_TYPE_DEFAULT);
+        png_set_filter(writer, PNG_FILTER_TYPE_BASE, PNG_FILTER_PAETH);
+        png_set_compression_level(writer, 2);
+        png_write_info(writer, info);
+        const size_t stride = static_cast<size_t>(width) * channels;
+        const size_t offset = static_cast<size_t>((height - out_h) / 2) * stride
+                              + static_cast<size_t>((width - out_w) / 2) * channels;
+        for (int y = 0; y < out_h; ++y)
+            png_write_row(writer, pixels + offset + static_cast<size_t>(y) * stride);
+        png_write_end(writer, info);
+        written = true;
+    }
+    png_destroy_write_struct(&writer, &info);
+    return std::fclose(file) == 0 && written;
+}
