+#pragma once
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+
+#include "ggml.h"
+
+namespace sd::euler_trace {
+struct Step {
+    int64_t upload_us = 0;
+    size_t upload_bytes = 0;
+    int64_t readback_us = 0;
+    size_t readback_bytes = 0;
+    int64_t gpu_wait_us = 0;
+    int64_t final_sync_us = 0;
+    int64_t scale_us = 0;
+    int64_t combine_us = 0;
+    int64_t preview_us = 0;
+    const void* latent = nullptr;
+};
+
+inline thread_local Step* active = nullptr;
+
+class Timer {
+    int64_t* target_ = nullptr;
+    int64_t start_ = 0;
+
+public:
+    explicit Timer(int64_t Step::*field, bool measure = true) {
+        if (measure && active != nullptr) {
+            target_ = &(active->*field);
+            start_ = ggml_time_us();
+        }
+    }
+    Timer(const Timer&) = delete;
+    Timer& operator=(const Timer&) = delete;
+    ~Timer() {
+        if (target_ != nullptr) {
+            *target_ += ggml_time_us() - start_;
+        }
+    }
+};
+
+class Scope {
+    Step* previous_;
+
+public:
+    explicit Scope(Step* step) : previous_(active) { active = step; }
+    ~Scope() { active = previous_; }
+};
+}  // namespace sd::euler_trace
